# Copie este archivo como .env antes de ejecutar Docker Compose.
# Nunca agregue el archivo .env real al repositorio.

DB_PASSWORD=REEMPLAZAR
JWT_SECRET=REEMPLAZAR_CON_BASE64_DE_32_BYTES
JWT_EXPIRATION_SECONDS=900

# Kafka (opcional en local; en false los eventos se omiten)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=REEMPLAZAR.aivencloud.com:12345
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=REEMPLAZAR
